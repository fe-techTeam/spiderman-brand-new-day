# Copy to .env.local and fill in. See BACKEND.md §14.

# ── MySQL ─────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=spiderman_bnd
DB_CONNECTION_LIMIT=10

# ── Auth ──────────────────────────────────────────
# Generate each with: openssl rand -base64 48  (use DIFFERENT values)
JWT_SECRET=
JWT_EXPIRES_IN=7d
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRES_IN=8h
BCRYPT_COST=12

# ── Bootstrap super admin (consumed by: npm run db:seed-admin) ──
ADMIN_SEED_NAME="Site Admin"
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=

# ── App ───────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
UPLOAD_DIR=uploads
