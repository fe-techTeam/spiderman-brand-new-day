# Copy to .env.local and fill in. See BACKEND.md §14.
# For Docker: copy to .env instead (docker-compose reads it) — DEPLOYMENT.md.

# ── MySQL ─────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=spiderman_bnd
DB_CONNECTION_LIMIT=10

# ── Auth ──────────────────────────────────────────
# Generate each with: openssl rand -base64 48  (use DIFFERENT values)
JWT_SECRET=
JWT_EXPIRES_IN=7d
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRES_IN=8h
BCRYPT_COST=12

# ── Bootstrap super admin (consumed by: npm run db:seed-admin) ──
ADMIN_SEED_NAME="Site Admin"
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=

# ── App ───────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Uploads & storage ─────────────────────────────
# Size caps enforced server-side (images are also lightly compressed via sharp)
MAX_IMAGE_UPLOAD_MB=5
MAX_VIDEO_UPLOAD_MB=50
# STORAGE_DRIVER=local stores under UPLOAD_DIR on disk.
# Switch to S3 by setting STORAGE_DRIVER=s3 + the S3_* values — no code change.
# Keep the bucket PRIVATE: files are always served through /api/media/[id],
# which enforces approval/ownership rules. CloudFront caches those responses
# at the edge (never point it at the bucket) — setup guide in DEPLOYMENT.md.
# Production: STORAGE_DRIVER=s3 so media survives container replacement.
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
S3_BUCKET_NAME=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional — only for S3-compatible providers (Cloudflare R2, MinIO, DO Spaces)
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
